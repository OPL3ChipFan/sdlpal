TARGET = sdlpal

SOURCES  = . .. ../adplug \
../liboggvorbis/src ../liboggvorbis/src/modes ../liboggvorbis/src/books/coupled ../liboggvorbis/src/books/floor ../liboggvorbis/src/books/uncoupled \
../libopusfile/src ../libopusfile/celt ../libopusfile/silk ../libopusfile/silk/float
CFILES   = $(foreach dir, $(SOURCES), $(wildcard $(dir)/*.c))
CPPFILES = $(foreach dir, $(SOURCES), $(wildcard $(dir)/*.cpp))

OBJS = $(CFILES:.c=$(INTER).o) $(CPPFILES:.cpp=$(INTER).o)

PSPSDK = $(shell psp-config --pspsdk-path)

INCDIR = 
CFLAGS = -O2 -G0 -Wall -g -I/usr/local/pspdev/psp/include/SDL2 \
-I../liboggvorbis/include -I../liboggvorbis/src -I../liboggvorbis/src/modes \
-I../liboggvorbis/src/books/coupled -I../liboggvorbis/src/books/floor -I../liboggvorbis/src/books/uncoupled \
-I../liboggvorbis/include -I../libopusfile/include -I../libopusfile/src -I../libopusfile/celt -I../libopusfile/silk -I../libopusfile/silk/float \
 -DPSP=1 -std=gnu99 -D_GNU_SOURCE -DHAVE_CONFIG_H

CXXFLAGS = $(CFLAGS) -fno-exceptions -fno-rtti -std=c++11 -I. -I../
ASFLAGS = $(CFLAGS)

LIBDIR =
LIBS =  -L/usr/local/pspdev/psp/lib -lSDL2main /usr/local/pspdev/psp/lib/libSDL2.a -lSDL2main /usr/local/pspdev/psp/lib/libSDL2.a -lm -lGL -lpspvram -lpspaudio -lpspvfpu -lpspdisplay -lpspgu -lpspge -lpsphprm -lpspctrl -lpsppower -lpspdebug -lstdc++ -L/usr/local/pspdev/psp/sdk/lib \
-lpspdebug -lpspgu -lpspctrl -lpspge -lpspdisplay -lpsphprm -lpspsdk -lpspaudio -lpspmp3 -lc \
-lpspirkeyb -lpsppower 


EXTRA_TARGETS = EBOOT.PBP
PSP_EBOOT_TITLE = SDLPal
#PSP_EBOOT_ICON = icon0.png
#PSP_EBOOT_PIC1 = PIC1.png

BUILD_PRX = 1
PSP_FW_VERSION = 371
#PSP_LARGE_MEMORY=1 

include $(PSPSDK)/lib/build.mak
